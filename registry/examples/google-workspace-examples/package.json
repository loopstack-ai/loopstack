{
  "name": "@loopstack/google-workspace-examples",
  "displayName": "Loopstack Google Workspace Examples",
  "description": "Google Workspace integration workflow examples for Loopstack — a scripted Google Calendar summary, and an interactive Claude agent with Calendar, Gmail and Drive tools. Both sign in through the OAuth sub-workflow on demand.",
  "keywords": [
    "loopstack",
    "example",
    "google",
    "google-workspace",
    "calendar",
    "gmail",
    "drive",
    "oauth",
    "workflow"
  ],
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/claude-module": "*",
    "@loopstack/common": "*",
    "@loopstack/google-workspace-module": "*",
    "@loopstack/llm-provider-module": "*",
    "@loopstack/oauth-module": "*",
    "@nestjs/common": "^12.0.1",
    "zod": "^4.3.6"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@loopstack/testing": "*",
    "vitest": "^4.1.6",
    "@swc/core": "^1.15.33",
    "unplugin-swc": "^1.5.9"
  }
}
