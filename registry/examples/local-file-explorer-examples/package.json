{
  "name": "@loopstack/local-file-explorer-examples",
  "displayName": "Loopstack Local File Explorer Examples",
  "description": "Local file explorer workflow example for Loopstack — build a file tree of the workspace with FileSystemService from @loopstack/local-file-explorer-module.",
  "keywords": [
    "loopstack",
    "example",
    "filesystem",
    "file-explorer",
    "workflow"
  ],
  "version": "0.1.1",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/common": "*",
    "@loopstack/local-file-explorer-module": "*",
    "@nestjs/common": "^12.0.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@loopstack/testing": "*",
    "vitest": "^4.1.6",
    "@swc/core": "^1.15.33",
    "unplugin-swc": "^1.5.9"
  }
}
