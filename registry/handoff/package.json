{
  "name": "@loopstack/handoff",
  "displayName": "Loopstack Handoff Module",
  "description": "Hand-off documents for Loopstack workflows — lights up the Studio Handoff panel (copy-a-command, open-a-URL and changed-files cards) and drives the CLI terminal-handoff widget",
  "keywords": [
    "loopstack",
    "handoff",
    "studio",
    "workflow"
  ],
  "version": "0.2.0",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/common": "^0.45.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@swc/core": "^1.15.33",
    "reflect-metadata": "^0.2.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "zod": "^4.0.0"
  },
  "files": [
    "dist"
  ]
}
