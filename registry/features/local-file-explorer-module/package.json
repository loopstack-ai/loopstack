{
  "name": "@loopstack/local-file-explorer-module",
  "displayName": "Loopstack Local File Explorer Module",
  "description": "Local filesystem file browsing for Loopstack workspaces — provides REST API for file tree and content access",
  "keywords": [
    "loopstack",
    "file-explorer",
    "filesystem",
    "workflow"
  ],
  "version": "0.26.3",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/common": "^0.44.0",
    "@loopstack/contracts": "^0.44.0",
    "@loopstack/core": "^0.44.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@swc/core": "^1.15.33",
    "typeorm": "^0.3.28",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/config": "^4.0.0 || ^12.0.0",
    "@nestjs/typeorm": "^11.0.0 || ^12.0.0",
    "typeorm": "^0.3.0"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
