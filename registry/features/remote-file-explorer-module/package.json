{
  "name": "@loopstack/remote-file-explorer-module",
  "displayName": "Loopstack Remote File Explorer Module",
  "description": "Remote file browsing for Loopstack workspaces — proxies file tree and content requests to remote agents",
  "keywords": [
    "loopstack",
    "file-explorer",
    "remote-agent",
    "workflow"
  ],
  "version": "0.27.2",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/common": "^0.44.0",
    "@loopstack/remote-client": "^0.29.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@swc/core": "^1.15.33",
    "typeorm": "^0.3.28",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/typeorm": "^11.0.0 || ^12.0.0",
    "typeorm": "^0.3.0"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
