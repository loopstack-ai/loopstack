{
  "name": "@loopstack/google-workspace-module",
  "displayName": "Google Workspace Module",
  "description": "Google Workspace integration for the Loopstack automation framework. Provides a Google OAuth 2.0 provider and tools for Google Workspace services such as Calendar, Drive, and Gmail.",
  "keywords": [
    "authentication",
    "calendar",
    "google",
    "google-workspace",
    "loopstack",
    "module",
    "oauth"
  ],
  "version": "0.5.4",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/oauth-module": "^0.5.0"
  },
  "devDependencies": {
    "@loopstack/testing": "^0.43.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.15.33",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
