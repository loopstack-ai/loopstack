{
  "name": "@loopstack/claims",
  "displayName": "Loopstack Claims Module",
  "description": "Resource claims for Loopstack workflows — exclusive and pooled resources claimed by a run or a workspace, released when their scope ends",
  "keywords": [
    "loopstack",
    "claims",
    "locking",
    "concurrency",
    "workflow"
  ],
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/common": "^0.44.0",
    "@loopstack/core": "^0.44.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "@swc/core": "^1.15.33",
    "typeorm": "^0.3.28",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/event-emitter": "^11.0.0 || ^12.0.0",
    "@nestjs/typeorm": "^11.0.0 || ^12.0.0",
    "typeorm": "^0.3.0",
    "zod": "^4.0.0"
  },
  "files": [
    "dist"
  ]
}
