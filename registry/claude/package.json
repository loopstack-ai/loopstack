{
  "name": "@loopstack/claude",
  "displayName": "Loopstack Claude Module",
  "description": "A collection of tools for performing AI actions using the Anthropic Claude API directly via the official SDK",
  "keywords": [
    "ai",
    "anthropic",
    "claude",
    "llm",
    "loopstack",
    "tool"
  ],
  "version": "0.29.0",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@loopstack/common": "^0.45.0",
    "@loopstack/llm-provider": "^0.12.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@swc/core": "^1.15.33",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/config": "^4.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "zod": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
