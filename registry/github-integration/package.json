{
  "name": "@loopstack/github-integration",
  "displayName": "Loopstack GitHub Integration",
  "description": "GitHub integration workflows for Loopstack — connect workspaces to GitHub repositories with OAuth, push, pull, and sync",
  "keywords": [
    "loopstack",
    "github",
    "git",
    "integration",
    "workflow"
  ],
  "version": "0.5.4",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/common": "^0.45.0",
    "@loopstack/core": "^0.45.0",
    "@loopstack/git": "^0.6.0",
    "@loopstack/github": "^0.5.0",
    "@loopstack/hitl": "^0.6.4",
    "@loopstack/oauth": "^0.6.0",
    "@loopstack/remote-client": "^0.29.2"
  },
  "devDependencies": {
    "@loopstack/testing": "^0.45.0",
    "@nestjs/common": "^12.0.1",
    "@swc/core": "^1.15.33",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "zod": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
