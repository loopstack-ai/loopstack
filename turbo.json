{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "watch": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["VITEST_MAX_WORKERS"]
    },
    "compile": {
      "dependsOn": ["^build"]
    }
  },
  "concurrency": "30"
}
