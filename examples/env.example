## Database and Redis (optional — defaults target the docker-compose services)
#DATABASE_HOST=
#DATABASE_PORT=
#DATABASE_USERNAME=
#DATABASE_NAME=
#DATABASE_PASSWORD=
#REDIS_HOST=
#REDIS_PORT=
#REDIS_PASSWORD=
## Redis database index. Every deployment sharing a Redis server needs its own — deployments on the
## same database share one task-queue and steal each other's jobs.
#REDIS_DB=

## LLM providers — needed by the llm, agent, hitl and secrets examples
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

## OAuth providers — needed by the github and google-workspace examples.
## Register the redirect URI below in the provider console.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/callback

## MCP — needed by the agent MCP example
#LINEAR_MCP_TOKEN=

## Remote sandbox — needed by the remote-client and remote-file-explorer examples
#SANDBOX_URL=http://localhost:3080
#SANDBOX_AGENT_URL=http://localhost:3031
