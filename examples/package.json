{
  "name": "examples",
  "version": "0.1.0",
  "description": "Every Loopstack example in one runnable app — one NestJS module per theme, each its own Studio app.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "smoke": "node scripts/smoke-run.mjs",
    "sync-deps": "node scripts/sync-module-deps.mjs",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/agent": "*",
    "@loopstack/api": "*",
    "@loopstack/claude-module": "*",
    "@loopstack/code-agent": "*",
    "@loopstack/common": "*",
    "@loopstack/contracts": "*",
    "@loopstack/core": "*",
    "@loopstack/git-module": "*",
    "@loopstack/github-integration": "*",
    "@loopstack/github-module": "*",
    "@loopstack/google-workspace-module": "*",
    "@loopstack/hitl": "*",
    "@loopstack/llm-provider-module": "*",
    "@loopstack/local-file-explorer-module": "*",
    "@loopstack/loopstack-module": "*",
    "@loopstack/mcp-module": "*",
    "@loopstack/oauth-module": "*",
    "@loopstack/openai-module": "*",
    "@loopstack/quota": "*",
    "@loopstack/remote-client": "*",
    "@loopstack/remote-file-explorer-module": "*",
    "@loopstack/sandbox-filesystem": "*",
    "@loopstack/sandbox-tool": "*",
    "@loopstack/secrets-module": "*",
    "@loopstack/web-module": "*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "bullmq": "^5.73.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@loopstack/cli": "*",
    "@loopstack/client": "*",
    "@loopstack/testing": "*",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.15.33",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6"
  }
}
