# All values are optional — the defaults below match docker-compose.yml.

# PORT=3000

# Point at any Postgres / Redis with a single URL (managed, hosted, or your own),
# or use the discrete vars below. A URL, when set, takes precedence.
# DATABASE_URL=postgres://postgres:admin@localhost:5432/postgres
# REDIS_URL=redis://localhost:6379

# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=admin
# DATABASE_NAME=postgres

# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# Redis database index. Give every app sharing a Redis server its own: apps on the same database
# share one task-queue and take each other's jobs.
# REDIS_DB=0

# API keys for LLM feature modules (e.g. @loopstack/claude-module)
# ANTHROPIC_API_KEY=

# How long a shutdown (Ctrl+C, SIGTERM) waits for in-flight runs to yield before
# the worker closes by force, in milliseconds. Raise it for long-running transitions.
# SHUTDOWN_DRAIN_TIMEOUT_MS=30000
