# All values are optional — the defaults below match docker-compose.yml.

# PORT=3000

# Point at any Postgres / Redis with a single URL (managed, hosted, or your own),
# or use the discrete vars below. A URL, when set, takes precedence.
# DATABASE_URL=postgres://postgres:admin@localhost:5432/postgres
# REDIS_URL=redis://localhost:6379

# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=admin
# DATABASE_NAME=postgres

# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# API keys for LLM feature modules (e.g. @loopstack/claude-module)
# ANTHROPIC_API_KEY=
