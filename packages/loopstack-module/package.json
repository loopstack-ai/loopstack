{
  "name": "@loopstack/loopstack-module",
  "displayName": "Loopstack Module",
  "description": "All-in-one NestJS module for bootstrapping a Loopstack application",
  "version": "0.36.1",
  "license": "MIT",
  "author": {
    "name": "Jakob Klippel",
    "url": "https://www.linkedin.com/in/jakob-klippel/"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "watch": "nest build --watch"
  },
  "dependencies": {
    "@loopstack/api": "^0.44.1",
    "@loopstack/auth": "^0.44.1",
    "@loopstack/common": "^0.44.1",
    "@loopstack/contracts": "^0.44.0",
    "@loopstack/core": "^0.44.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "pg": "^8.20.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@swc/core": "^1.15.33",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/config": "^4.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0"
  },
  "files": [
    "dist",
    "docker-compose.yml",
    "docker-compose.studio.yml"
  ]
}
