---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PageBackdrop from '../../components/PageBackdrop.astro';
import PageHead from '../../components/PageHead.astro';
import { formatDate, getPosts } from '../../lib/blog';
import '../../styles/landing.css';

const posts = await getPosts();
---

<StarlightPage
  frontmatter={{
    title: 'Blog',
    description: 'Releases, patterns and notes from the people building Loopstack.',
    template: 'splash',
    editUrl: false,
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <div class="landing not-content">
    <PageHead title="Blog" lede="Releases, patterns and notes from the people building Loopstack." />

    <section class="listing">
      <ul class="posts">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>
                {post.data.img && (
                  <span class="thumb">
                    <img src={post.data.img} alt="" loading="lazy" class={post.data.imgThemeAdapt ? 'adapt' : ''} />
                  </span>
                )}
                <span class="body">
                  <span class="title">
                    {post.data.title}
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                  </span>
                  <span class="teaser">{post.data.description}</span>
                  <span class="meta">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    {post.data.author && <> · {post.data.author}</>}
                    {post.data.draft && (
                      <>
                        {' · '}
                        <strong>draft</strong>
                      </>
                    )}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="page-foot"><PageBackdrop place="foot" /></div>
  </div>
</StarlightPage>

<style>
  .landing {
    text-align: start;
  }
  .listing {
    width: 100%;
    padding: 2rem 1.5rem 5rem;
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 68rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .posts > li {
    margin: 0;
  }
  .posts a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .posts a:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-6);
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--sl-color-gray-6);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb img.adapt {
    object-fit: contain;
    padding: 1rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4rem 1.5rem 1.5rem;
  }
  .title {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-weight: 600;
    font-size: var(--sl-text-xl);
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .arrow {
    color: var(--sl-color-gray-4);
    transition: transform 0.2s ease;
  }
  .posts a:hover .arrow {
    transform: translateX(2px);
    color: var(--sl-color-accent);
  }
  .teaser {
    margin-top: 0.6rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-base);
    line-height: 1.65;
  }
  .meta {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-sm);
  }
  .page-foot {
    position: relative;
    height: 6rem;
  }
</style>
