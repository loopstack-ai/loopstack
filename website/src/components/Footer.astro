---
/**
 * Starlight's page footer (edit link, last updated, pagination) followed by the site footer, so
 * every page carries the same navigation and legal links.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import BrandRule from './BrandRule.astro';

const sections = [
  {
    title: 'Resources',
    links: [
      { title: 'Blog', href: '/blog' },
      { title: 'Documentation', href: '/docs/learn/introduction' },
      { title: 'llms.txt', href: '/llms.txt' },
    ],
  },
  { title: 'Platform', links: [{ title: 'Sign in', href: 'https://app.loopstack.ai' }] },
  {
    title: 'Company',
    links: [
      { title: 'Legal Notice', href: '/p/imprint' },
      { title: 'Privacy Policy', href: '/p/privacy-policy' },
    ],
  },
];

const socials = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/loopstack-ai/',
    d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/loopstack-ai/loopstack',
    d: 'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z',
  },
  {
    label: 'Discord',
    href: 'https://discord.gg/svAHrkxKZg',
    d: 'M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.87-.61 1.25a18.27 18.27 0 0 0-5.48 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04A19.74 19.74 0 0 0 3.68 4.37a.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06c0 .02.02.04.04.06a19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.22-2a.08.08 0 0 0-.04-.1 13.1 13.1 0 0 1-1.87-.9.08.08 0 0 1 0-.13l.37-.29a.07.07 0 0 1 .08 0 14.2 14.2 0 0 0 12.06 0 .07.07 0 0 1 .08 0l.37.3a.08.08 0 0 1 0 .12c-.6.35-1.22.65-1.87.9a.08.08 0 0 0-.04.1c.36.7.78 1.36 1.23 2a.08.08 0 0 0 .08.02 19.84 19.84 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.67-3.56-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42Zm7.98 0c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.95 2.42-2.16 2.42Z',
  },
];

const year = new Date().getFullYear();
---

<Default />

<div class="site-footer-wrap">
  <BrandRule />
  <footer class="site-footer">
    <div class="brand">
      <div class="brand-row">
        <span class="wordmark">Loopstack</span>
        <span class="socials">
          {
            socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d={s.d} />
                </svg>
              </a>
            ))
          }
        </span>
      </div>
      <p class="copyright">© {year} Loopstack GmbH. All rights reserved.</p>
    </div>

    <div class="columns">
      {
        sections.map((s) => (
          <div>
            <h2>{s.title}</h2>
            <ul>
              {s.links.map((l) => (
                <li>
                  <a href={l.href} {...(l.href.startsWith('http') ? { rel: 'noopener noreferrer' } : {})}>
                    {l.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </footer>
</div>

<style>
  .site-footer-wrap {
    margin-top: 4rem;
  }
  .site-footer {
    max-width: 72rem;
    margin-inline: auto;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  @media (min-width: 60rem) {
    .site-footer {
      flex-direction: row;
      justify-content: space-between;
      gap: 4rem;
    }
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .wordmark {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .socials {
    display: flex;
    gap: 1rem;
  }
  .socials a {
    color: var(--sl-color-gray-3);
    display: inline-flex;
  }
  .socials a:hover {
    color: var(--sl-color-white);
  }
  .copyright {
    margin: 1rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;
  }
  @media (min-width: 40rem) {
    .columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .columns h2 {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--sl-color-white);
  }
  .columns ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .columns li {
    margin: 0;
  }
  .columns a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }
  .columns a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
</style>
