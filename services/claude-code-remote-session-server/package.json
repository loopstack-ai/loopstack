{
  "name": "@loopstack/claude-code-remote-session-server",
  "displayName": "Claude Code Remote Session Server",
  "description": "In-container agent server that supervises headless Claude Code sessions and exposes them over HTTP",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "compile": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "test": "jest --passWithNoTests",
    "docker:build:base": "docker build -f Dockerfile.base -t loopstack-engineer-base:latest .",
    "docker:build": "docker build -t loopstack-engineer-agent:latest .",
    "docker:build:apprunner": "docker build -f Dockerfile.apprunner -t loopstack-engineer-apprunner:latest .",
    "docker:build:base-dind": "docker build -f Dockerfile.base-dind -t loopstack-engineer-base-dind:latest .",
    "docker:build:dind": "docker build --build-arg BASE_IMAGE=loopstack-engineer-base-dind:latest -t loopstack-engineer-agent-dind:latest .",
    "docker:build:apprunner-dind": "docker build -f Dockerfile.apprunner --build-arg BASE_IMAGE=loopstack-engineer-base-dind:latest -t loopstack-engineer-apprunner-dind:latest .",
    "docker:build:all": "npm run docker:build:base && npm run docker:build && npm run docker:build:apprunner && npm run docker:build:base-dind && npm run docker:build:dind && npm run docker:build:apprunner-dind"
  },
  "dependencies": {
    "express": "^5.2.1",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
}
